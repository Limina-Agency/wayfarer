    "RouteSpeedPreference": {
      "type": "string",
      "enum": [
        "posted_or_inferred",
        "posted",
        "inferred",
        "free_flow",
        "constrained",
        "road_type_default"
      ]
    },
    "SarBarriers": {
      "description": "R4.",
      "type": "object",
      "properties": {
        "gateS": {
          "type": "number",
          "format": "double",
          "default": 90.0
        },
        "lockedGateS": {
          "type": "number",
          "format": "double",
          "default": 300.0
        },
        "motorBlocking": {
          "$ref": "#/$defs/SarMotorBlocking",
          "default": "impassable"
        }
      }
    },
    "SarConditional": {
      "description": "R6: `ignore` (default true when the relaxation is named).",
      "type": "object",
      "properties": {
        "ignore": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "SarLegalAccess": {
      "description": "R1. `military` is relaxed only when listed; `private` or `customers`\nlift the destination-only confinement of the whole request (see\n`lifts_destination_only`).",
      "type": "object",
      "properties": {
        "factor": {
          "type": "number",
          "format": "double",
          "default": 1.2
        },
        "values": {
          "type": "array",
          "default": [
            "private",
            "no",
            "customers",
            "forestry",
            "agricultural"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SarMotorBlocking": {
      "description": "How R4 treats barriers that block motor vehicles (bollards, blocks).",
      "oneOf": [
        {
          "description": "Impassable for vehicles (the default).",
          "type": "string",
          "const": "impassable"
        },
        {
          "description": "Passable on foot only: the route ends its vehicle part there.",
          "type": "string",
          "const": "foot_only"
        }
      ]
    },
    "SarOffNetwork": {
      "description": "R7.",
      "type": "object",
      "properties": {
        "costed": {
          "description": "X6: cost the leg (`crate::access`, at the profile's off-road pace and\na cost factor of 1). The join is then chosen by total time among the\ncandidates within `max_leg_m`, and the route's cost, duration,\ndistance, geometry and maneuvers include the leg; the report's\n`added_cost_s` is both the cost and the duration they add. Off by\ndefault: the leg is reported and left out of the totals.",
          "type": "boolean"
        },
        "maxLegM": {
          "type": "number",
          "format": "double",
          "default": 2000.0
        }
      }
    },
    "SarTurnRestrictions": {
      "description": "R3: each violated simple or complex restriction costs `penalty_s`.",
      "type": "object",
      "properties": {
        "penaltyS": {
          "type": "number",
          "format": "double",
          "default": 60.0
        }
      }
    },
    "SarUnknownWidth": {
      "description": "Whether R5 admits paths of unknown width.",
      "type": "string",
      "enum": [
        "deny",
        "allow"
      ]
    },
    "SarVehicleOnPaths": {
      "description": "R5.",
      "type": "object",
      "properties": {
        "classes": {
          "type": "array",
          "default": [
            "pedestrian",
            "cycleway",
            "footway",
            "path",
            "bridleway"
          ],
          "items": {
            "type": "string"
          }
        },
        "factor": {
          "type": "number",
          "format": "double",
          "default": 3.0
        },
        "minWidthM": {
          "type": "number",
          "format": "double",
          "default": 2.5
        },
        "unknownWidth": {
          "$ref": "#/$defs/SarUnknownWidth",
          "default": "deny"
        }
      }
    },
    "SarWrongWay": {
      "description": "R2.",
      "type": "object",
      "properties": {
        "entryS": {
          "type": "number",
          "format": "double",
          "default": 30.0
        },
        "factor": {
          "type": "number",
          "format": "double",
          "default": 2.0
        }
      }
    },
    "SarZone": {
      "description": "A zone the planner draws, as a closed polygon (the last point need not\nrepeat the first).",
      "type": "object",
      "properties": {
        "factor": {
          "description": "`weight` zones: the probability multiplier, finite and above 0.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "id": {
          "description": "The planner's label, echoed in results.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SarZoneKind"
        },
        "polygon": {
          "description": "At least three points.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeoPoint"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "polygon"
      ]
    },
    "SarZoneKind": {
      "description": "How a zone shapes the prediction (see `docs/design/sar-planning.md` 2.3).",
      "oneOf": [
        {
          "description": "The person cannot enter it (a river, a cliff band): blocked in every\nsearch, so it holds no probability.",
          "type": "string",
          "const": "no_go"
        },
        {
          "description": "The person tends to avoid it (dense forest, a steep slope, private\nground): blocked in the complying search only, and the result is a\nmixture of the complying and the free search by\n`ReachRequest::avoid_compliance`.",
          "type": "string",
          "const": "avoid"
        },
        {
          "description": "The search is unchanged; the probability of the edges inside is\nmultiplied by `factor` (above 1 for places the person is drawn to,\nbelow 1 for places they are unlikely to stop), then renormalised.",
          "type": "string",
          "const": "weight"
        }
      ]
    },
    "Stopping": {
      "description": "When the person stopped moving (design 2.2). Lost people rest, shelter,\nget hurt or wander back, so most are found far inside their full reach.",
      "oneOf": [
        {
          "description": "Equally likely at any time up to the moving budget: the time moved is\nuniform between 0 and `elapsed * moving_fraction`.",
          "type": "string",
          "const": "uniform"
        },
        {
          "description": "Never: everyone is at the end of their full reach (the outward bound\nof the travel-time model).",
          "type": "string",
          "const": "never"
        }
      ]
    }
  }
}
