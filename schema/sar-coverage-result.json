{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageResult",
  "type": "object",
  "properties": {
    "coveredEdges": {
      "description": "Sorted by edge key.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoveredEdge"
      }
    },
    "probability": {
      "description": "The probability after an unsuccessful search (Bayes): searched edges\nlose, everything else (rest of world included) gains.",
      "$ref": "#/$defs/ProbabilityMap"
    },
    "probabilityOfSuccess": {
      "description": "`sum(POA_e POD_e)`: the chance the search so far would have found the\nperson (cumulative probability of success).",
      "type": "number",
      "format": "double"
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SegmentCoverage"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TrackCoverage"
      }
    }
  },
  "required": [
    "tracks",
    "coveredEdges",
    "segments",
    "probability",
    "probabilityOfSuccess"
  ],
  "$defs": {
    "CoveredEdge": {
      "description": "An edge a team searched.",
      "type": "object",
      "properties": {
        "edgeId": {
          "description": "The undirected key.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "passes": {
          "description": "Traversals over all tracks (out and back counts twice).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pod": {
          "description": "`1 - product((1 - pod) ^ passes)` over the tracks.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "edgeId",
        "passes",
        "pod"
      ]
    },
    "EdgeProbability": {
      "description": "One edge's probability of holding the person.",
      "type": "object",
      "properties": {
        "avoidOnly": {
          "description": "Reached only by crossing an `avoid` zone (or inside one).",
          "type": "boolean"
        },
        "edgeId": {
          "description": "The undirected key (the smaller directed id of the edge's two).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "lengthM": {
          "type": "number",
          "format": "double"
        },
        "probability": {
          "type": "number",
          "format": "double"
        },
        "timeS": {
          "description": "The model time at which the edge is first entered (the complying\nsearch's when it reaches the edge).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "edgeId",
        "probability",
        "lengthM"
      ]
    },
    "ProbabilityMap": {
      "description": "Probability of area on the network: per edge, plus what lies beyond.\nEdges, `unlisted`, `rest_of_world` and `off_network` add up to 1.",
      "type": "object",
      "properties": {
        "edges": {
          "description": "Sorted by edge key; only edges above 0.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EdgeProbability"
          }
        },
        "offNetwork": {
          "description": "Mass of bands or rings with no reachable path in them (the network\nended: the person went off the network or stopped at its end).",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "restOfWorld": {
          "description": "Beyond the outermost band (faster than nearly everyone, or outside the\ndistance rings).",
          "type": "number",
          "format": "double"
        },
        "unlisted": {
          "description": "Mass of reached edges left out of `edges` by the request's `maxEdges`\nor `minEdgeProbability`: on the network, but not on any listed edge.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "edges",
        "restOfWorld",
        "offNetwork"
      ]
    },
    "SegmentCoverage": {
      "type": "object",
      "properties": {
        "coverage": {
          "description": "`covered_length_m / network_length_m` (0 for a segment with no path).",
          "type": "number",
          "format": "double"
        },
        "coveredLengthM": {
          "type": "number",
          "format": "double"
        },
        "networkLengthM": {
          "type": "number",
          "format": "double"
        },
        "pod": {
          "description": "Probability-weighted detection: `sum(POA_e POD_e) / sum(POA_e)`\n(length-weighted where the segment holds no probability).",
          "type": "number",
          "format": "double"
        },
        "probabilityAfter": {
          "type": "number",
          "format": "double"
        },
        "probabilityBefore": {
          "type": "number",
          "format": "double"
        },
        "segmentId": {
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "networkLengthM",
        "coveredLengthM",
        "coverage",
        "pod",
        "probabilityBefore",
        "probabilityAfter"
      ]
    },
    "TrackCoverage": {
      "type": "object",
      "properties": {
        "coveredLengthM": {
          "type": "number",
          "format": "double"
        },
        "failure": {
          "description": "Why nothing matched, when nothing did.",
          "type": [
            "string",
            "null"
          ]
        },
        "matchedSampleCount": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "teamId": {
          "type": "string"
        }
      },
      "required": [
        "teamId",
        "matchedSampleCount",
        "sampleCount",
        "coveredLengthM"
      ]
    }
  }
}
