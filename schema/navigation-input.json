{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteNavigationInput",
  "type": "object",
  "properties": {
    "distanceMeters": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "durationSeconds": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "geometry": {
      "description": "The route's points; or empty, with `polyline6`.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/GeoPoint"
      }
    },
    "maneuvers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RouteManeuver"
      }
    },
    "polyline6": {
      "description": "The route's points as an encoded polyline at precision 6 (as a route\nwith `geometryFormat: \"polyline6\"` returns it), in place of\n`geometry`.",
      "type": [
        "string",
        "null"
      ]
    },
    "shapeSegmentDurationsSeconds": {
      "description": "The duration of each of `shape_segments`, for the remaining duration;\nwithout them it is the total duration in proportion to distance.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      }
    },
    "shapeSegmentSpeedLimitsKph": {
      "description": "The speed limit (km/h) of each of `shape_segments`' edges, `null`\nwhere unknown or for a connector, for progress's `speedLimitKph`.",
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ],
        "format": "float"
      }
    },
    "shapeSegments": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RouteShapeSegment"
      }
    }
  },
  "$defs": {
    "GeoPoint": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "format": "double"
        },
        "lng": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "lat",
        "lng"
      ]
    },
    "RouteDynamicEndpointKind": {
      "type": "string",
      "enum": [
        "origin",
        "destination"
      ]
    },
    "RouteDynamicVirtualEdgeKind": {
      "type": "string",
      "enum": [
        "endpoint",
        "road_entry",
        "road_to_road_bypass",
        "cross_country"
      ]
    },
    "RouteGuidanceQualityFlag": {
      "type": "string",
      "enum": [
        "missing_road_name",
        "inferred_heading",
        "complex_junction",
        "weak_maneuver_classification",
        "combined_short_connector",
        "overlay_warning_on_clipped_shape",
        "ssvg_connector"
      ]
    },
    "RouteLane": {
      "description": "One lane of the road approaching a maneuver's junction.",
      "type": "object",
      "properties": {
        "indications": {
          "description": "The lane's marked directions, in tag order; `none` for an unmarked\nlane. Marks the engine does not know are left out.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteLaneIndication"
          }
        },
        "valid": {
          "description": "Whether the lane serves the maneuver.",
          "type": "boolean"
        }
      },
      "required": [
        "indications",
        "valid"
      ]
    },
    "RouteLaneIndication": {
      "description": "A direction marked on a lane (an OSM `turn:lanes` value).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "through",
            "slight_left",
            "left",
            "sharp_left",
            "slight_right",
            "right",
            "sharp_right",
            "reverse",
            "merge_to_left",
            "merge_to_right"
          ]
        },
        {
          "description": "No marking (`none` or an empty value): usually straight on.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "RouteManeuver": {
      "type": "object",
      "properties": {
        "alertInstruction": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "bearingDeg": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "beginShapeIndex": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "branchText": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "cardinalDirection": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "conciseInstruction": {
          "type": "string",
          "default": ""
        },
        "distanceM": {
          "type": "number",
          "format": "double"
        },
        "durationS": {
          "type": "number",
          "format": "double"
        },
        "endShapeIndex": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "instruction": {
          "type": "string"
        },
        "instructionKey": {
          "type": "string",
          "default": ""
        },
        "instructionParameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "kind": {
          "$ref": "#/$defs/RouteManeuverKind"
        },
        "laneCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "default": null,
          "maximum": 255,
          "minimum": 0
        },
        "lanes": {
          "description": "The lanes of the road approaching the maneuver's junction, left to\nright, from that road's `turn:lanes` tags; empty when it has none or\nthe maneuver is not at a junction.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteLane"
          }
        },
        "legIndex": {
          "description": "The leg of a multi-leg route this maneuver belongs to.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "postTransitionInstruction": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "preTransitionInstruction": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "qualityFlags": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteGuidanceQualityFlag"
          }
        },
        "roadName": {
          "type": [
            "string",
            "null"
          ]
        },
        "roadRefs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "roundaboutExitNumber": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "signText": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "turnAngleDeg": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768
        }
      },
      "required": [
        "kind",
        "instruction",
        "distanceM",
        "durationS",
        "beginShapeIndex",
        "endShapeIndex"
      ]
    },
    "RouteManeuverKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "start",
            "continue",
            "keep",
            "fork",
            "merge",
            "roundabout",
            "turn",
            "u_turn",
            "hazard",
            "destination"
          ]
        },
        {
          "description": "Arrival at an intermediate waypoint of a multi-leg route.",
          "type": "string",
          "const": "waypoint"
        }
      ]
    },
    "RouteShapeDynamicOverlay": {
      "type": "object",
      "properties": {
        "connectorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "connectorType": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteDynamicVirtualEdgeKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "distanceMeters": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "durationSeconds": {
          "description": "Travel time, for access stretches (a connector's is its cost).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "kind": {
          "$ref": "#/$defs/RouteShapeDynamicOverlayKind"
        },
        "sourceChunkIds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "sourceEdgeId": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "sourceEndpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteDynamicEndpointKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceFraction": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sourcePoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoPoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetEdgeId": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "targetEndpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteDynamicEndpointKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetFraction": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "targetPoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoPoint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "RouteShapeDynamicOverlayKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "partial_edge_fragment",
            "endpoint_connector",
            "road_entry_connector",
            "road_to_road_bypass_connector",
            "cross_country_connector"
          ]
        },
        {
          "description": "A costed off-network access stretch (`crate::access`).",
          "type": "string",
          "const": "access_leg"
        }
      ]
    },
    "RouteShapeQualityFlag": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "clipped_origin_edge",
            "clipped_destination_edge",
            "waypoint_split",
            "duplicated_edge_suppressed",
            "shape_fallback_used",
            "same_edge_direct",
            "ssvg_partial_edge_split",
            "ssvg_connector"
          ]
        },
        {
          "description": "The leg starts away from where the previous leg ended (the waypoint\nsnapped to different places for its two legs).",
          "type": "string",
          "const": "waypoint_gap"
        },
        {
          "description": "A costed off-network access stretch between a requested point and\nthe road network (`crate::access`); no edge of its own.",
          "type": "string",
          "const": "off_network_access"
        }
      ]
    },
    "RouteShapeSegment": {
      "type": "object",
      "properties": {
        "beginShapeIndex": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "dynamicOverlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteShapeDynamicOverlay"
            },
            {
              "type": "null"
            }
          ]
        },
        "edgeId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "endFraction": {
          "type": "number",
          "format": "double"
        },
        "endShapeIndex": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "qualityFlags": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteShapeQualityFlag"
          }
        },
        "startFraction": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "edgeId",
        "beginShapeIndex",
        "endShapeIndex",
        "startFraction",
        "endFraction"
      ]
    }
  }
}
