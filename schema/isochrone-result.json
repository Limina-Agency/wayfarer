{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteIsochroneResult",
  "type": "object",
  "properties": {
    "buckets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteIsochroneBucket"
      }
    },
    "origin": {
      "$ref": "#/$defs/CorrelatedLocation"
    },
    "origins": {
      "description": "Where each of the request's `origins` snapped, in order (origin 0 is\n`origin`).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CorrelatedLocation"
      }
    },
    "polygons": {
      "description": "With the request's `polygons`, the polygon options as applied: the\ngrid's cell size, the spread and the denoise share.",
      "anyOf": [
        {
          "$ref": "#/$defs/RouteIsochronePolygonOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "settledNodeCount": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "truncated": {
      "description": "The search stopped at `max_expansion_edge_count` before exhausting the\nlargest contour: buckets and boundary fragments are incomplete (every\nedge listed is reachable, but some reachable edges are missing).",
      "type": "boolean",
      "default": false
    },
    "visitedEdgeCount": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "required": [
    "origin",
    "buckets",
    "visitedEdgeCount",
    "settledNodeCount",
    "truncated"
  ],
  "$defs": {
    "CorrelatedLocation": {
      "type": "object",
      "properties": {
        "componentSize": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "distanceM": {
          "type": "number",
          "format": "double"
        },
        "edgeId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fractionAlongEdge": {
          "type": "number",
          "format": "double"
        },
        "headingDeg": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "headingDeltaDeg": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "inboundReachEdgeCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "layer": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int16",
          "default": null,
          "maximum": 32767,
          "minimum": -32768
        },
        "level": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "opposingEdgeId": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "outboundReachEdgeCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "roadGroupKey": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sameRoadCandidateCount": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "score": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "scoreBreakdown": {
          "$ref": "#/$defs/CorrelationScoreBreakdown",
          "default": {
            "accessScore": 0.0,
            "candidateTypeScore": 0.0,
            "componentScore": 0.0,
            "distanceScore": 0.0,
            "headingScore": 0.0,
            "layerScore": 0.0,
            "levelScore": 0.0,
            "reachScore": 0.0,
            "roadClassScore": 0.0,
            "sideScore": 0.0,
            "totalScore": 0.0
          }
        },
        "sharedEdgeInfoId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "side": {
          "$ref": "#/$defs/CorrelationSide",
          "default": "unknown"
        },
        "snappedPoint": {
          "$ref": "#/$defs/GeoPoint"
        },
        "sourceNodeId": {
          "type": "integer",
          "format": "int64"
        },
        "targetNodeId": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "edgeId",
        "sharedEdgeInfoId",
        "opposingEdgeId",
        "roadGroupKey",
        "sameRoadCandidateCount",
        "sourceNodeId",
        "targetNodeId",
        "snappedPoint",
        "distanceM",
        "fractionAlongEdge",
        "headingDeg",
        "headingDeltaDeg",
        "side",
        "componentSize",
        "outboundReachEdgeCount",
        "inboundReachEdgeCount",
        "layer",
        "level",
        "score",
        "scoreBreakdown",
        "confidence"
      ]
    },
    "CorrelationScoreBreakdown": {
      "type": "object",
      "properties": {
        "accessScore": {
          "type": "number",
          "format": "double"
        },
        "candidateTypeScore": {
          "type": "number",
          "format": "double"
        },
        "componentScore": {
          "type": "number",
          "format": "double"
        },
        "distanceScore": {
          "type": "number",
          "format": "double"
        },
        "headingScore": {
          "type": "number",
          "format": "double"
        },
        "layerScore": {
          "type": "number",
          "format": "double"
        },
        "levelScore": {
          "type": "number",
          "format": "double"
        },
        "reachScore": {
          "type": "number",
          "format": "double"
        },
        "roadClassScore": {
          "type": "number",
          "format": "double"
        },
        "sideScore": {
          "type": "number",
          "format": "double"
        },
        "totalScore": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "distanceScore",
        "headingScore",
        "roadClassScore",
        "accessScore",
        "componentScore",
        "reachScore",
        "sideScore",
        "layerScore",
        "levelScore",
        "candidateTypeScore",
        "totalScore"
      ]
    },
    "CorrelationSide": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "on_edge",
        "unknown"
      ]
    },
    "GeoJsonMultiPolygon": {
      "description": "A GeoJSON `MultiPolygon` geometry (RFC 7946): polygons of linear rings,\neach closed (its last position repeats its first), the first ring of a\npolygon its outer boundary (counterclockwise) and the others its holes\n(clockwise), in `[longitude, latitude]` positions rounded to 6 decimals,\nas [`GeoJsonLineString`]. No polygon at all is an empty `coordinates`.",
      "type": "object",
      "properties": {
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            }
          }
        },
        "type": {
          "$ref": "#/$defs/GeoJsonMultiPolygonType"
        }
      },
      "required": [
        "type",
        "coordinates"
      ]
    },
    "GeoJsonMultiPolygonType": {
      "description": "The type member of a GeoJSON polygon geometry; always `MultiPolygon` here.",
      "type": "string",
      "enum": [
        "MultiPolygon"
      ]
    },
    "GeoPoint": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "format": "double"
        },
        "lng": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "lat",
        "lng"
      ]
    },
    "RouteIsochroneBoundaryFragment": {
      "type": "object",
      "properties": {
        "edgeId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "end": {
          "$ref": "#/$defs/GeoPoint"
        },
        "endFraction": {
          "type": "number",
          "format": "double"
        },
        "endMetric": {
          "type": "number",
          "format": "double"
        },
        "origin": {
          "description": "With `includeOrigins`, the origin whose path the fragment ends.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "start": {
          "$ref": "#/$defs/GeoPoint"
        },
        "startFraction": {
          "type": "number",
          "format": "double"
        },
        "startMetric": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "edgeId",
        "start",
        "end",
        "startFraction",
        "endFraction",
        "startMetric",
        "endMetric"
      ]
    },
    "RouteIsochroneBucket": {
      "type": "object",
      "properties": {
        "boundaryFragments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteIsochroneBoundaryFragment"
          }
        },
        "contour": {
          "type": "number",
          "format": "double"
        },
        "edgeIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "edgeOrigins": {
          "description": "With `includeOrigins`, the origin that reaches each of `edge_ids`\nfirst on this bucket's metric, parallel to it.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          }
        },
        "metric": {
          "$ref": "#/$defs/RouteIsochroneMetric"
        },
        "polygon": {
          "description": "With `polygons`, the bucket drawn as a GeoJSON `MultiPolygon` (see\n`RouteIsochronePolygonOptions`); empty when the bucket reaches\nnothing.",
          "anyOf": [
            {
              "$ref": "#/$defs/GeoJsonMultiPolygon"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contour",
        "metric",
        "edgeIds",
        "boundaryFragments"
      ]
    },
    "RouteIsochroneMetric": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "cost",
            "time_seconds"
          ]
        },
        {
          "description": "Metres along the cheapest path (as time is: labels are ordered by\ncost whatever the metric).",
          "type": "string",
          "const": "distance_m"
        }
      ]
    },
    "RouteIsochronePolygonOptions": {
      "description": "How an isochrone draws its buckets as polygons (see\n`RouteIsochroneRequest::polygons`). The polygon is drawn on a square grid\nover the reached roads: a grid node is inside when it lies within\n`spread_m` of a reached road, where on a boundary fragment the spread\nshrinks to what remains of the contour at the profile's off-road pace\n(metres for a distance contour), down to nothing where the fragment ends.\nRings follow the grid (marching squares), so the polygon is exact only to\nabout a cell; they never touch, before or after rounding. The bucket's `edgeIds` and boundary fragments stay the\nexact answer; the polygon is a function of them and the package's road\nshapes. Every value is optional; the result's `polygons` echoes the\nvalues used.",
      "type": "object",
      "properties": {
        "denoise": {
          "description": "Drops each polygon whose area is less than this share of the largest\npolygon's in its bucket (0 to 1; by default 0, which keeps every\none). Holes are kept.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "resolutionM": {
          "description": "The grid's cell size in metres, from 2 to 10,000. By default the\nlarger side of the reached area over 256, rounded up to whole metres\nand kept within 10 m to 500 m.\nA grid that would exceed `limits::MAX_ISOCHRONE_POLYGON_GRID_NODES`\nnodes takes larger cells.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "spreadM": {
          "description": "How far off a reached road the polygon reaches, in metres, at most\n10,000. By default 1.5 cells; never less than 0.75 of a cell, so\nthat every reached road meets the grid.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    }
  }
}
